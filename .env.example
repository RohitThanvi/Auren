# Copy to .env and fill in. Never commit .env.
# Consumed by docker compose and by `uv run --env-file ../../.env` in apps/api and apps/agent.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=auren
POSTGRES_PASSWORD=
POSTGRES_DB=auren

# --- API: core ---
AUREN_ENVIRONMENT=development
AUREN_LOG_LEVEL=INFO
AUREN_HOST=127.0.0.1
AUREN_PORT=8000
# Must use the asyncpg driver. Host is localhost when the API runs outside compose.
AUREN_DATABASE_URL=postgresql+asyncpg://auren:<POSTGRES_PASSWORD>@localhost:5432/auren
AUREN_REDIS_URL=redis://localhost:6379/0
# Comma-separated explicit origins. Wildcards are rejected.
AUREN_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API that append to X-Forwarded-For. 0 = none.
AUREN_TRUSTED_PROXY_COUNT=0

# --- API: Clerk (from the Clerk dashboard) ---
AUREN_CLERK_ISSUER=https://<your-instance>.clerk.accounts.dev
# Comma-separated origins allowed as the token `azp` claim. Required in production.
AUREN_CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Optional: only set if your Clerk JWT template defines an audience.
AUREN_CLERK_AUDIENCE=

# --- API: rate limits, format "<requests>/<window_seconds>" ---
AUREN_RATE_LIMIT_ANONYMOUS=60/60
AUREN_RATE_LIMIT_AUTHENTICATED=120/60
AUREN_RATE_LIMIT_AUTH=10/60
AUREN_RATE_LIMIT_TICKET_CREATION=10/60
AUREN_RATE_LIMIT_SESSION_CREATION=5/60
AUREN_RATE_LIMIT_UPLOAD=10/600
AUREN_RATE_LIMIT_EXPENSIVE=5/60
# false = reject requests with 503 when Redis is unreachable (recommended).
AUREN_RATE_LIMIT_FAIL_OPEN=false

# --- Tests only (databases are truncated by the test suite; names must end in _test) ---
AUREN_TEST_DATABASE_URL=postgresql+asyncpg://auren:<POSTGRES_PASSWORD>@localhost:5432/auren_test
AUREN_TEST_REDIS_URL=redis://localhost:6379/15

# --- Provider agent (apps/agent), development mode only ---
AUREN_AGENT_MODE=development
# Directory whose free space is reported as allocatable storage.
AUREN_AGENT_STORAGE_PATH=/tmp
AUREN_AGENT_LOG_LEVEL=INFO
AUREN_AGENT_GPU_PROBE_TIMEOUT_SECONDS=5
